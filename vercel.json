{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/([a-z/-]+)",
      "destination": "/api/index?__ruta=$1"
    }
  ]
}