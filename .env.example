CONTRACT_SOURCE=mock
INOVA_SOURCE=mock
PORT=3001

# Cuenta de prueba. El hash privado se crea con supervisor:clave.
SUPERVISOR_USER=supervisor_agencia_app
SUPERVISOR_CONCURRENCY=2
# Vercel: hash Argon2id generado por supervisor:clave. No subir el valor real.
SUPERVISOR_HASH=
# Con MySQL, pilot requiere números de contratos autorizados como arreglo JSON privado.
SUPERVISOR_SCOPE=pilot
SUPERVISOR_PILOT_CONTRACTS=[]
# Origen HTTPS exacto; vacío localmente. Vercel usa su URL de despliegue si no se define.
SUPERVISOR_ORIGIN=

# Solo para CONTRACT_SOURCE=mysql. Usar una cuenta de solo lectura.
DB_HOST=
DB_PORT=3306
# Plazo total para TCP, saludo, TLS y autenticación, en milisegundos.
DB_CONNECT_TIMEOUT_MS=15000
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_TLS=true
# Usar VERIFY_CA únicamente con autorización para la cuenta de consulta de contratos.
DB_TLS_MODE=VERIFY_IDENTITY
# Opcional en VERIFY_IDENTITY. DNS oficial del certificado si DB_HOST es una IP ausente del SAN.
DB_TLS_SERVERNAME=
# Ruta local al PEM de la CA institucional.
DB_SSL_CA_FILE=
# En Vercel, PEM como variable privada; también admite saltos de línea literales \n.
DB_SSL_CA_CONTENT=

# Solo el backend usa estas opciones. Activar INOVA_SOURCE=real con MySQL y autorización.
INOVA_BASE_URL=https://databridge-api.in-ova-bi.co
INOVA_API_KEY=
INOVA_FORM_GESTION=nPozbdjobkkpiIsdgI0zFXrvPdUm8FgJRw==
INOVA_FORM_SUPERVISION=_qCVahYhHpXHyjBWlcl5ozFNf4UxLTxO_w==
# Cuenta de cobro y Pago de Seguridad Social - APP Medellín Contratistas.
INOVA_FORM_COBRO=lmW2bbWMwGFOru75HQCIwvIaT6txPRPsCA==
# Puntero JSON al número completo del contrato dentro de cada fila de results.
# Completar con las rutas verificadas para cada formulario.
INOVA_RUTA_CONTRATO_GESTION=
INOVA_RUTA_CONTRATO_SUPERVISION=
# Ruta de entidad para cotejar el contrato obtenido de MySQL. Verificar cobro con inova:check -- --cobro.
# INOVA_RUTA_CONTRATO_ENTIDAD=/identification
# Para esta vía, deja vacías las dos rutas directas de formulario.
INOVA_RUTA_CONTRATO_ENTIDAD=

# Requeridas para el panel de supervisión en Vercel (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
